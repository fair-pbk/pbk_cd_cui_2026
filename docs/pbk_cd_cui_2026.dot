	AKidneyB_RBC -> AETB_RBC;
	AKidneyB_RBC -> AKidneyB_Free;
	AKidneyT_Free -> AKidneyB_Free;
	AKidneyT_Free -> AKidneyT_MT;
	AKidneyT_Free -> AUrineKidneyTissue;
	AKidneyT_MT -> AKidneyT_Free;
	AKidneyT_MT -> AUrineKidneyTissue;
